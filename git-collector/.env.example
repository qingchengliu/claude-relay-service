# ragent Git-AI Collector 环境配置

# Git-AI Collector 对外端口，避免和主服务 PORT 冲突
GIT_AI_PORT=8000

# 默认团队 API Key (请务必修改为安全的随机字符串)
DEFAULT_API_KEY=risk-ai

# 管理看板登录用户名和密码 (HTTP Basic Auth)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=doveliu123

# 数据库路径 (SQLite, 自动创建)
DATABASE_URL=sqlite+aiosqlite:///./data/collector.db

# 远程仓库地址包含过滤；逗号分隔，留空表示不过滤
REPO_URL_INCLUDE_CONTAINS=
